<?xml version="1.0" encoding="utf-8"?>
<ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/newIDlayout"
        tools:context=".IDeditor"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">
        <LinearLayout android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:orientation="vertical">
                <Button
                        android:id="@+id/btnSave"
                        android:text="@string/speichern"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                <TextView
                        android:text="@string/g_ltig_bis"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"/>
                <EditText
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:inputType="date"
                        android:ems="10"
                        android:id="@+id/valid_until"/>
                <TextView
                        android:text="@string/vorname"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"/>
                <EditText
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:inputType="text"
                        android:ems="10"
                        android:id="@+id/firstName"/>
                <TextView
                        android:text="@string/nachname"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"/>
                <EditText
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:inputType="text"
                        android:ems="10"
                        android:id="@+id/surname"/>
                <TextView
                        android:text="@string/geburtsdatum"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"/>
                <EditText
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:inputType="date"
                        android:ems="10"
                        android:id="@+id/birthdate"/>
                <TextView
                        android:text="@string/adresse"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"/>
                <EditText
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:inputType="text"
                        android:ems="10"
                        android:id="@+id/address"/>
                <TextView
                        android:textSize="20sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FF5722"
                        android:textStyle="bold|italic"
                        android:text="@string/dynamische_attribute"/>
                <LinearLayout
                        android:id="@+id/dynamicAttributes"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                </LinearLayout>
                <Button
                        android:id="@+id/btnAddPersonalimage"
                        android:text="@string/passbild_hinzuf_gen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                <TextView
                        android:text=""
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:id="@+id/personalImagePath"/>
                <Button
                        android:id="@+id/btnAddHandSignature"
                        android:text="@string/h_ndische_unterschrift_hinzuf_gen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                <TextView
                        android:text=""
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:id="@+id/handSignaturePath"/>
        </LinearLayout>
</ScrollView>